#compdef kee

_kee() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  # Check current word position
  case $CURRENT in
    2)
      # First argument - show commands
      local -a commands
      commands=(
        'add:Add a new AWS profile'
        'use:Use a profile (interactive picker if no name given)'
        'ls:List all configured profiles'
        'current:Show current active profile'
        'rm:Remove a profile (interactive picker if no name given)'
        'set:Update profile settings'
        'run:Run a command with a profile (no sub-shell)'
        'aws:Run an AWS CLI command with a profile'
        'console:Open the AWS Management Console for a profile'
      )
      _describe 'commands' commands
      ;;
    3)
      # Second argument - depends on the command
      case ${words[2]} in
        use|rm|set|run|aws|console)
          # Get real account names from kee
          local -a accounts
          local account_output
          account_output=$(kee ls --names 2>/dev/null)
          
          # Convert output to array, filtering out error messages
          while IFS= read -r line; do
            if [[ -n "$line" && "$line" != *"No accounts"* && "$line" != *"Use 'kee"* ]]; then
              accounts+=("$line")
            fi
          done <<< "$account_output"
          
          if (( ${#accounts[@]} > 0 )); then
            _values 'accounts' "${accounts[@]}"
          else
            _message 'no accounts configured'
          fi
          ;;
        add)
          _message 'account name'
          ;;
        ls)
          # Handle --names flag for ls command
          _arguments \
            '--names[Only show account names]'
          ;;
        current)
          # No arguments for current command
          return 0
          ;;
      esac
      ;;
    *)
      # No more completions after the second argument for most commands
      case ${words[2]} in
        ls)
          # ls can have flags, so continue with argument completion
          _arguments \
            '--names[Only show account names]'
          ;;
        set)
          # set has --production and --no-production flags
          _arguments \
            '--production[Mark as a production account]' \
            '--no-production[Unmark as a production account]'
          ;;
        *)
          # For all other commands, no more completions
          return 0
          ;;
      esac
      ;;
  esac
}

_kee "$@"
